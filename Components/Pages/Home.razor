@using SharedTaskBoard.Components.Shared
@using SharedTaskBoard.Services
@implements IDisposable
@inject TaskService TaskService

@page "/"

<PageTitle>Shared Task Board</PageTitle>

<div class="container py-4">
    <h1 class="mb-2">
        Shared Task Board
        <span class="badge bg-primary">@TaskCount</span>
    </h1>

    <p class="text-muted mb-4">
        Общий список задач для совместной работы
    </p>

    <AddTaskForm />
    <TaskList />
</div>

@code {
    private int TaskCount => TaskService.GetCount();

    protected override void OnInitialized()
    {
        TaskService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TaskService.OnChange -= HandleChange;
    }
}
