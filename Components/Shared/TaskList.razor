@using SharedTaskBoard.Models
@using SharedTaskBoard.Services
@implements IDisposable
@inject TaskService TaskService

<div class="card shadow-sm p-4">
    <h4>Список задач</h4>

    <div class="mb-3">
        <label for="taskFilter" class="form-label">Фильтр задач</label>
        <select id="taskFilter" class="form-select"
                @bind="SelectedFilter">
            <option value="all">Все задачи</option>
            <option value="completed">Только выполненные</option>
            <option value="active">Только невыполненные</option>
        </select>
    </div>

    @if (FilteredTasks.Count == 0)
    {
        <p class="text-muted">
            @EmptyMessage
        </p>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Выполнено</th>
                    <th>Название</th>
                    <th>Дата создания</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in FilteredTasks)
                {
                    <tr @key="task.Id">
                        <td>
                            <input type="checkbox"
                                   class="form-check-input"
                                   checked="@task.IsCompleted"
                                   @onchange="() => ToggleTask(task.Id)" />
                        </td>
                        <td>
                            @if (task.IsCompleted)
                            {
                                <span class="text-decoration-line-through text-muted">
                                    @task.Title
                                </span>
                            }
                            else
                            {
                                @task.Title
                            }

                            <div>
                                <a href="@($"/task/{task.Id}")">
                                    Подробнее
                                </a>
                            </div>
                        </td>
                        <td>@task.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => DeleteTask(task.Id)">
                                Удалить
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private string SelectedFilter { get; set; } = "all";

    private List<TaskItem> FilteredTasks
    {
        get
        {
            var tasks = TaskService.GetAll();

            return SelectedFilter switch
            {
                "completed" => tasks.Where(task => task.IsCompleted).ToList(),
                "active" => tasks.Where(task => !task.IsCompleted).ToList(),
                _ => tasks
            };
        }
    }

    private string EmptyMessage => SelectedFilter switch
    {
        "completed" => "Выполненных задач пока нет.",
        "active" => "Невыполненных задач нет.",
        _ => "Пока задач нет. Добавьте первую!"
    };

    protected override void OnInitialized()
    {
        TaskService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleTask(Guid id)
    {
        TaskService.Toggle(id);
    }

    private void DeleteTask(Guid id)
    {
        TaskService.Delete(id);
    }

    public void Dispose()
    {
        TaskService.OnChange -= HandleChange;
    }
}
